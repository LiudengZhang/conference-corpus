# Separate public repo, cloned here as a working copy
_awesome-virtual-cell/

# Claude Code project metadata
.claude/

# macOS
.DS_Store

# Large binary artifacts (PDFs downloaded on demand, not versioned)
**/pdfs/
*.pdf

# Temporary/scratch
/tmp/
/_scratch/

# MkDocs build output
site/
# Cloudflare Pages local state
.wrangler/

# Generated at build time
docs/assets/*-posters.json
docs/javascripts/tabulator.min.js
docs/sessions/*.md
!docs/sessions/index.md

docs/stylesheets/tabulator.min.css

# Python bytecode
__pycache__/
*.py[cod]

# Build-generated files (regenerated by scripts/build_site.py on each build)
docs/conferences/*/sessions/
docs/assets/*/posters/
docs/assets/*/bioinfo-tools/

# Baseline snapshot for refactor validation
_baseline/
.codex-output/
# L1 layer: regenerable from PubMed and Crossref, so it is not stored.
# These patterns previously carried trailing `#` comments on the same line.
# .gitignore has no inline comments — the pattern was read as the whole
# line, matched nothing, and data/index.sqlite was committed as a binary
# blob on every rebuild for four months before anyone checked.
data/index.sqlite
data/conference.sqlite
# Regulatory layer: regenerable by scripts/harvest_regulatory.py from FDA,
# EMA and ClinicalTrials.gov, so it is not stored.
data/regulatory.sqlite
# Regenerable from public RSS/Atom feeds by scripts/harvest_news.py.
# Comment stays on its own line: .gitignore has no inline comments.
data/news.sqlite

# L1 harvest TSVs: regenerable from PubMed, but retained so the next
# window extension is incremental instead of re-pulling every month.
data/harvest/
